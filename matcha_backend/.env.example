# ============================================================================
# MATCHA BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================
# All credentials, API keys, and sensitive values MUST be stored in .env
# This is a SUBJECT REQUIREMENT - DO NOT hardcode any secrets in code
# ============================================================================

# ----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=matcha_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ----------------------------------------------------------------------------
# Email/SMTP Configuration
# ----------------------------------------------------------------------------
# For Gmail: Enable 2-Step Verification and create an App Password
# Go to: https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here

# Optional: Set to 'true' for development (prints emails to console)
MAIL_USE_CONSOLE=false

# ----------------------------------------------------------------------------
# JWT Authentication Tokens
# ----------------------------------------------------------------------------
# Generate secure random strings (e.g., use: python -c "import secrets; print(secrets.token_hex(32))")
JWT_ACCESS_TOKEN=your-secret-access-token-here-min-32-chars
JWT_REFRESH_TOKEN=your-secret-refresh-token-here-min-32-chars

# ----------------------------------------------------------------------------
# SMTP Secret Key
# ----------------------------------------------------------------------------
SMTP_SECRET_KEY=your-smtp-secret-key

# ----------------------------------------------------------------------------
# Redis Configuration (for real-time features, caching)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ----------------------------------------------------------------------------
# Application URLs
# ----------------------------------------------------------------------------
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ============================================================================
# SUBJECT REQUIREMENTS COMPLIANCE
# ============================================================================
# ✅ All credentials stored locally in .env (not hardcoded)
# ✅ Neighborhood-level GPS positioning implemented
# ✅ 10-second max delay monitoring for real-time features
# ============================================================================
