# Runtime configuration for Matcha Backend
# This file is read by the application to enable/disable features

# Email Configuration
# Set to 'true' to print emails to console instead of sending via SMTP
# Set to 'false' to use real SMTP (requires MAIL_USERNAME and MAIL_PASSWORD)
MAIL_USE_CONSOLE=true

# Email SMTP Settings (only needed if MAIL_USE_CONSOLE=false)
MAIL_USERNAME=
MAIL_PASSWORD=

# Application URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
